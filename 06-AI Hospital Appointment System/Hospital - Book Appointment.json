    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\n\nconst requiredFields = [\n  'patient_name',\n  'phone_number',\n  'specialty_id',\n  'doctor_id',\n  'date',\n  'time',\n  'reason'\n];\n\nconst missingFields = requiredFields.filter(field => {\n  return !body[field] || String(body[field]).trim() === '';\n});\n\nif (missingFields.length > 0) {\n  return [\n    {\n      json: {\n        success: false,\n        error: 'missing_fields',\n        message: `Missing required booking fields: ${missingFields.join(', ')}`,\n        missing_fields: missingFields\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      patient_name: String(body.patient_name).trim(),\n      phone_number: String(body.phone_number).trim(),\n      specialty_id: String(body.specialty_id).trim(),\n      doctor_id: String(body.doctor_id).trim(),\n      date: String(body.date).trim(),\n      time: String(body.time).trim(),\n      reason: String(body.reason).trim()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
