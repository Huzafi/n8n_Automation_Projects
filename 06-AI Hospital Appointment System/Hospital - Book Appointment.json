        "jsCode": "const crypto = require('crypto');\n\nconst appointmentId = `APT-${Date.now()}-${crypto.randomBytes(3).toString('hex').toUpperCase()}`;\n\nreturn [\n  {\n    json: {\n      ...$json,\n      appointment_id: appointmentId\n    }\n  }\n];"
      },
