    {
      "parameters": {
        "jsCode": "const input = $('Validate Booking Request').item.json;\nconst appointments = $input.all();\n\nconst requestedDoctor = input.doctor_id;\nconst requestedDate = input.date;\nconst requestedTime = input.time;\n\nconst alreadyBooked = appointments.some(item => {\n  const appointment = item.json;\n\n  return (\n    appointment.doctor_id === requestedDoctor &&\n    appointment.date === requestedDate &&\n    appointment.time === requestedTime &&\n    appointment.status === 'booked'\n  );\n});\n\nif (alreadyBooked) {\n  return [\n    {\n      json: {\n        success: false,\n        error: 'slot_unavailable',\n        message: 'The selected appointment slot is no longer available.',\n        doctor_id: requestedDoctor,\n        date: requestedDate,\n        time: requestedTime\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      slot_available: true\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
