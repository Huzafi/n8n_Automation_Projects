    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Generated appointment slots\nconst slots = items.filter(item => {\n  return item.json.slot_duration;\n});\n\n// Existing booked appointments\nconst bookedAppointments = items.filter(item => {\n  return (\n    item.json.appointment_id &&\n    item.json.doctor_id &&\n    item.json.date &&\n    item.json.time &&\n    item.json.status === 'booked'\n  );\n});\n\n// Create a quick lookup of already booked slots\nconst bookedSlots = new Set(\n  bookedAppointments.map(item =>\n    `${item.json.doctor_id}|${item.json.date}|${item.json.time}`\n  )\n);\n\n// Remove already booked slots\nconst availableSlots = slots.filter(item => {\n  const key = `${item.json.doctor_id}|${item.json.date}|${item.json.time}`;\n\n  return !bookedSlots.has(key);\n});\n\nreturn availableSlots;"
      },
