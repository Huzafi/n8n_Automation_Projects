    {
      "parameters": {
        "jsCode": "const slots = $input.all();\n\nif (slots.length === 0) {\n  return [\n    {\n      json: {\n        success: true,\n        doctor_id: null,\n        date: null,\n        available_slots: []\n      }\n    }\n  ];\n}\n\nconst doctor_id = slots[0].json.doctor_id;\nconst date = slots[0].json.date;\n\nconst available_slots = slots.map(item => item.json.time);\n\nreturn [\n  {\n    json: {\n      success: true,\n      doctor_id,\n      date,\n      available_slots\n    }\n  }\n];"
      },
